# Create a bot with BotFather and put only your numeric Telegram user IDs here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# UNSAFE: writes raw MTS callback JSON, which may contain authentication secrets.
TELEGRAM_RAW_AUTH_LOG=false

# Optional SDK configuration overrides can be placed in this file too.
# URENT_ANDROID_PROFILE=pixel-8
# URENT_TIMEOUT=30
